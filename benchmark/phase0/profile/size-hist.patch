+//! Phase 0 only (a local, uncommitted measuring patch): counts of the facade's operations by operand size.
+//! Bucket b holds operands of [2^(b-1), 2^b) words (bucket 0: zero). At process exit, if SB_SIZE_HIST
+//! names a file, one line per (op, bucket) is appended: `pid op bucket count words_sum small_count[...]`.
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+pub const OPS: &[&str] = &[
+    "Add", "Sub", "Mul", "Div", "Rem", "BitAnd", "BitOr", "BitXor", "Add_prim", "Sub_prim", "Mul_prim", "Div_prim",
+    "Rem_prim", "BitAnd_prim", "BitOr_prim", "BitXor_prim", "gcd", "div_rem", "conv", "Shl", "Shr",
+];
+const NB: usize = 26;
+const Z: AtomicU64 = AtomicU64::new(0);
+const ROW: [AtomicU64; NB] = [Z; NB];
+static COUNT: [[AtomicU64; NB]; 21] = [ROW; 21];
+static WORDS: [[AtomicU64; NB]; 21] = [ROW; 21];
+/// for Mul: counts by (larger bucket, smaller bucket)
+static MUL2: [[AtomicU64; NB]; NB] = [ROW; NB];
+
+fn bucket(words: usize) -> usize {
+    if words == 0 { 0 } else { ((usize::BITS - words.leading_zeros()) as usize).min(NB - 1) }
+}
+
+fn idx(op: &str) -> usize {
+    OPS.iter().position(|o| *o == op).unwrap_or(OPS.len() - 1)
+}
+
+#[inline(never)]
+pub fn rec(op: &str, a: usize, b: usize) {
+    let i = idx(op);
+    let big = a.max(b);
+    let k = bucket(big);
+    COUNT[i][k].fetch_add(1, Relaxed);
+    WORDS[i][k].fetch_add((a + b) as u64, Relaxed);
+    if op == "Mul" {
+        MUL2[k][bucket(a.min(b))].fetch_add(1, Relaxed);
+    }
+}
+
+pub trait Words {
+    fn nwords(&self) -> usize;
+}
+impl Words for dashu_int::IBig {
+    fn nwords(&self) -> usize {
+        self.as_sign_words().1.len()
+    }
+}
+impl Words for dashu_int::UBig {
+    fn nwords(&self) -> usize {
+        self.as_words().len()
+    }
+}
+#[inline]
+pub fn words<T: Words>(x: &T) -> usize {
+    x.nwords()
+}
+
+extern "C" fn dump() {
+    let Ok(path) = std::env::var("SB_SIZE_HIST") else { return };
+    let mut out = String::new();
+    let pid = std::process::id();
+    for (i, op) in OPS.iter().enumerate() {
+        for k in 0..NB {
+            let c = COUNT[i][k].load(Relaxed);
+            if c > 0 {
+                out.push_str(&format!("{} {} {} {} {}\n", pid, op, k, c, WORDS[i][k].load(Relaxed)));
+            }
+        }
+    }
+    for k in 0..NB {
+        for j in 0..NB {
+            let c = MUL2[k][j].load(Relaxed);
+            if c > 0 {
+                out.push_str(&format!("{} Mul2 {}x{} {} 0\n", pid, k, j, c));
+            }
+        }
+    }
+    use std::io::Write;
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = f.write_all(out.as_bytes());
+    }
+}
+
+#[allow(unsafe_code)]
+#[used]
+#[link_section = ".fini_array"]
+static DUMP_AT_EXIT: extern "C" fn() = dump;
